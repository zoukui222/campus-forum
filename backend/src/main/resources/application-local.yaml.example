# 本地开发配置模板
# 使用方法：复制本文件为同目录下的 application-local.yaml，并填入真实值。
# application-local.yaml 已加入 .gitignore，不会被提交到版本库。
# application.yaml 中 spring.profiles.active 默认为 local，启动时会自动加载本文件。

spring:
  data:
    redis:
      host: localhost
      port: 6379
      password: your_redis_password
  datasource:
    username: root
    password: your_mysql_password
    url: jdbc:mysql://localhost:3306/campus_forum?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

service:
  download:
    # 图片上传存储目录（建议使用绝对路径，结尾带斜杠）
    address: D:/your-path/backend/file/
